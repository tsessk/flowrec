{
  "experiment_name": "tiger_beauty_grpo",
  "required_checkpoints": [
    "model.checkpoint_path",
    "method.reference_model_checkpoint"
  ],
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/reviews_Beauty.json.gz",
    "metadata_path": "data/raw/meta_Beauty.json.gz",
    "semantic_id_path": "datasets/semantic_ids/exp1-standard params/beauty/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "offset_semantic_ids_by_one": true
  },
  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 2000,
    "num_heads": 6,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "dim_feedforward": 1024,
    "d_kv": 64,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 100,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": null
  },
  "method": {
    "name": "grpo",
    "beta": 0.04,
    "clip_epsilon": 0.2,
    "num_negatives": 4,
    "negative_sampler": "random",
    "reward_positive": 1.0,
    "reward_negative": 0.0,
    "normalize_advantages": true,
    "reference_model_strategy": "checkpoint",
    "reference_model_checkpoint": null,
    "loss_reduction": "mean",
    "sft_weight": 0.1,
    "metric_prefix": "grpo",
    "evaluate_generation": true,
    "generation_topk": [
      5,
      10,
      20
    ]
  },
  "training": {
    "max_epochs": 300,
    "max_steps": 200000,
    "validate_every_epochs": 30,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 2,
    "max_grad_norm": 1.0,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "log_every_steps": 200,
    "checkpoint_dir": "experiments/checkpoints/tiger_beauty_grpo",
    "save_best": true,
    "save_last": true,
    "monitor": "val/sft/generation_ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 5,
    "min_delta": 0.001,
    "evaluate_generation": true,
    "generation_topk": [
      5,
      10,
      20
    ]
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null
}
