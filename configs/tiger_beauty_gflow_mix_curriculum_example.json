{
  "experiment_name": "tiger_beauty_gflow_mix_curriculum_example",
  "required_checkpoints": [
    "method.sasrec.checkpoint_path"
  ],
  "seed": 42,
  "data": {
    "reviews_path": "data/processed/tiger_beauty_interactions.jsonl",
    "semantic_id_path": "artifacts/tokenizers/rqvae_beauty_reference/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "split_strategy": "leave_one_out",
    "train_all_prefixes": false,
    "train_target_policy": "last_n",
    "train_last_n": 20,
    "max_history_len": 20,
    "history_padding": "right",
    "offset_semantic_ids_by_one": false
  },
  "dataloader": {
    "batch_size": 256,
    "eval_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true,
    "train_drop_last": false
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 2000,
    "num_heads": 6,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "dim_feedforward": 1024,
    "d_kv": 64,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 100,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02
  },
  "method": {
    "name": "gflow",
    "objective": "tb",
    "candidate_sampler": "sasrec",
    "sft_weight": 1.0,
    "gflow_weight": 0.1,
    "reward_cache_path": "artifacts/reward_cache/beauty",
    "reward_cache_power": 1.0,
    "num_negative_samples": 1,
    "sasrec": {
      "checkpoint_path": null,
      "model": {
        "embedding_dim": 64,
        "num_heads": 2,
        "num_layers": 2,
        "dropout": 0.3
      }
    },
    "easy_negative_steps": 5000,
    "candidate_pool_size": 1024,
    "candidate_sampling_temperature": 1.0
  },
  "training": {
    "max_epochs": 40,
    "validate_every_epochs": 2,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 2,
    "max_grad_norm": 1.0,
    "log_every_steps": 200,
    "save_best": true,
    "save_last": true,
    "monitor": "val/sft/loss",
    "monitor_mode": "min",
    "early_stopping_patience": 20,
    "min_delta": 0.0,
    "evaluate_generation": false,
    "generation_topk": [
      5,
      10,
      20
    ],
    "generation_constrain_valid_sequences": true,
    "generation_exclude_seen_items": true,
    "test_evaluate_generation": true,
    "test_generation_num_beams": 100
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "comet": {
    "enabled": false,
    "project_name": "flowrec",
    "tags": [
      "tiger",
      "beauty",
      "gflow",
      "mix-reward",
      "sasrec-curriculum"
    ]
  }
}
