{
  "experiment_name": "tiger_beauty_mini_one_rec_sample_rule_rank",
  "seed": 42,
  "data": {
    "reviews_path": "data/raw/dataframe_format/reviews_beauty_2014.parquet",
    "metadata_path": "data/raw/dataframe_format/meta_beauty_2014.parquet",
    "semantic_id_path": "datasets/semantic_ids/exp1-standard_params/beauty/semantic_ids.json"
  },
  "dataset": {
    "num_codebooks": 4,
    "max_sequence_length": 20,
    "max_history_len": 20,
    "min_user_interactions": 5,
    "min_item_interactions": 5,
    "item_key": "asin",
    "positive_criterion": "verified_purchase == True",
    "filter_cold_items_after_split": false,
    "split_strategy": "leave_one_out",
    "train_all_prefixes": true,
    "train_target_policy": "all",
    "train_example_layout": "prefix_target",
    "offset_semantic_ids_by_one": true
  },
  "dataloader": {
    "train_batch_size": 256,
    "validation_batch_size": 256,
    "num_workers": 8,
    "pin_memory": true,
    "include_raw_in_batch": true,
    "train_drop_last": true,
    "prefetch_factor": 4
  },
  "model": {
    "embedding_dim": 128,
    "codebook_size": 256,
    "num_positions": 20,
    "user_ids_count": 1,
    "use_user_token": true,
    "num_heads": 6,
    "num_encoder_layers": 2,
    "num_decoder_layers": 2,
    "dim_feedforward": 512,
    "d_kv": 32,
    "dropout": 0.1,
    "activation": "relu",
    "num_beams": 20,
    "top_k": 20,
    "layer_norm_eps": 1e-06,
    "initializer_range": 0.02,
    "checkpoint_path": "checkpoints/exp1/tiger/beauty/best.pt"
  },
  "training": {
    "max_epochs": 3,
    "max_steps": 200000,
    "validate_every_epochs": 20,
    "validate_every_steps": null,
    "gradient_accumulation_steps": 1,
    "max_grad_norm": 1,
    "use_amp": true,
    "amp_dtype": "bfloat16",
    "log_every_steps": 50,
    "checkpoint_dir": "experiments/checkpoints/tiger_beauty",
    "save_best": true,
    "save_last": true,
    "monitor": "val/sft/generation_ndcg@10",
    "monitor_mode": "max",
    "early_stopping_patience": 5,
    "min_delta": 0.001,
    "evaluate_generation": true
  },
  "optimizer": {
    "lr": 1e-05,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  },
  "scheduler": null,
  "method": {
    "name": "mini-one-rec",
    "rollout_strategy": "sample",
    "reward_type": "rule_rank",
    "num_generations": 8,
    "rollout_temperature": 1.0,
    "rollout_top_k": 100,
    "rollout_top_p": 0.98,
    "force_ground_truth_in_group": true,
    "rank_reward_weight": 0.05,
    "normalize_rank_reward": false,
    "clip_epsilon": 0.1,
    "beta": 0.003,
    "sync_ref_every_steps": null,
    "rollout_constrain_valid_sequences": true,
    "rollout_exclude_seen_items": false,
    "do_sample": true,
    "sft_weight": 0.2
  }
}
